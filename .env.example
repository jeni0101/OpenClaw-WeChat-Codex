# This file documents names only. Never put secrets in Git.
WECHAT_CLAWBOT_DATA=/opt/WeChat-Open in/data
WECHAT_CLAWBOT_SOCKET=/opt/WeChat-Open in/data/run/project-ops.sock
WECHAT_CLAWBOT_REGISTRY=/opt/WeChat-Open in/config/projects.yaml
WECHAT_CLAWBOT_BROKER_CREDENTIAL=/run/credentials/wechat-clawbot-ops.service/broker-token
WECHAT_CLAWBOT_OWNER_CREDENTIAL=/run/credentials/wechat-clawbot-ops.service/owner-wechat-id
WEIXIN_CDN_PRIMARY_METHOD=POST
WEIXIN_CDN_PRIMARY_URL_SOURCE=full
# Set only after the complete acceptance matrix qualifies a different method.
WEIXIN_CDN_ALTERNATE_METHOD=
# Presign and CDN upload must use this same trusted egress.
WEIXIN_CDN_SOCKS_PROXY=socks5h://127.0.0.1:19080
WECHAT_MEDIA_ACCOUNT_ID=REPLACE_WITH_WECHAT_ACCOUNT_ID
COS_BUCKET=REPLACE_WITH_PRIVATE_COS_BUCKET
COS_REGION=REPLACE_WITH_COS_REGION
