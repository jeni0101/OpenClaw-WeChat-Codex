{
  "id": "wechat-media-bridge",
  "name": "WeChat Safe Media Bridge",
  "description": "Owner-only work-file validation, extraction and de-duplicated native WeChat delivery.",
  "version": "0.3.1",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "socketPath": { "type": "string" },
      "accountId": { "type": "string" },
      "workspaceRoot": { "type": "string" }
    }
  },
  "contracts": {
    "tools": ["weixin_send_current_attachment", "weixin_get_attachment_status", "workfile_import_generated_image", "workfile_extract"],
    "hooks": ["message_sending", "message_sent", "gateway_stop"]
  }
}
