[Unit]
Description=Encrypted WeChat ClawBot %i backup to Tencent COS
RequiresMountsFor=/opt/WeChat-Open\x20in/data
After=network-online.target opt-WeChat\x2dOpen\x20in-data.mount
Wants=network-online.target

[Service]
Type=oneshot
User=wechat-clawbot
Group=wechat-clawbot
Slice=wechat-clawbot.slice
WorkingDirectory=/opt/WeChat-Open in
Environment="WECHAT_CLAWBOT_DATA=/opt/WeChat-Open in/data"
EnvironmentFile=/etc/wechat-clawbot/runtime.env
LoadCredentialEncrypted=cos-secret-id:/etc/credstore.encrypted/wechat-clawbot-cos-secret-id.cred
LoadCredentialEncrypted=cos-secret-key:/etc/credstore.encrypted/wechat-clawbot-cos-secret-key.cred
ExecStart="/opt/WeChat-Open in/data/node/bin/node" "/opt/WeChat-Open in/dist/scripts/backup.js" --%i
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
CapabilityBoundingSet=
ReadWritePaths="/opt/WeChat-Open in/data"
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
