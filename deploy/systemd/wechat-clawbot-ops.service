[Unit]
Description=WeChat ClawBot allowlisted host operations broker
RequiresMountsFor=/opt/WeChat-Open\x20in/data
After=network-online.target opt-WeChat\x2dOpen\x20in-data.mount
Wants=network-online.target

[Service]
Type=simple
User=root
Group=wechat-clawbot
Slice=wechat-clawbot.slice
WorkingDirectory=/opt/WeChat-Open in
Environment="WECHAT_CLAWBOT_DATA=/opt/WeChat-Open in/data"
Environment="WECHAT_CLAWBOT_SOCKET=/opt/WeChat-Open in/data/run/project-ops.sock"
Environment="WECHAT_CLAWBOT_REGISTRY=/opt/WeChat-Open in/config/projects.yaml"
Environment="OPENCLAW_CONFIG_PATH=/opt/WeChat-Open in/config/openclaw.json"
Environment=WECHAT_CLAWBOT_CODEX_ENABLED=1
Environment="WECHAT_CLAWBOT_CODEX_EXECUTABLE=/opt/WeChat-Open in/node_modules/.bin/codex"
Environment="WECHAT_CLAWBOT_CODEX_RUNNER=/opt/WeChat-Open in/dist/src/ops/codex-runner.js"
Environment="WECHAT_CLAWBOT_CODEX_HOME=/opt/WeChat-Open in/data/state/codex"
Environment="WECHAT_CLAWBOT_CODEX_AGENT_DIR=/opt/WeChat-Open in/data/state/agents/main/agent"
Environment=NODE_OPTIONS=--max-old-space-size=256
LoadCredentialEncrypted=broker-token:/etc/credstore.encrypted/wechat-clawbot-broker-token.cred
LoadCredentialEncrypted=owner-wechat-id:/etc/credstore.encrypted/wechat-clawbot-owner-wechat-id.cred
ExecStart="/opt/WeChat-Open in/data/node/bin/node" "/opt/WeChat-Open in/dist/src/ops/broker.js"
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETUID CAP_SETGID
AmbientCapabilities=CAP_SETUID CAP_SETGID
ReadWritePaths="/opt/WeChat-Open in/data" -/srv/wechat-clawbot/projects/example
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
OOMPolicy=continue

[Install]
WantedBy=multi-user.target
